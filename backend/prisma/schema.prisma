generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model audit_log {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?   @db.Uuid
  action        String    @db.VarChar(100)
  resource_type String?   @db.VarChar(100)
  resource_id   String?   @db.Uuid
  details       Json?
  ip_address    String?   @db.Inet
  user_agent    String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  users         users?    @relation(fields: [user_id], references: [id])

  @@index([action], map: "idx_audit_log_action")
  @@index([created_at(sort: Desc)], map: "idx_audit_log_created_at")
  @@index([user_id, action], map: "idx_audit_log_user_action")
  @@index([user_id], map: "idx_audit_log_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model feedback {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  response_id            String              @unique @db.Uuid
  session_id             String              @db.Uuid
  question_id            String              @db.Uuid
  relevance_score        Decimal?            @db.Decimal(5, 2)
  clarity_score          Decimal?            @db.Decimal(5, 2)
  confidence_score       Decimal?            @db.Decimal(5, 2)
  completeness_score     Decimal?            @db.Decimal(5, 2)
  overall_response_score Decimal?            @db.Decimal(5, 2)
  strengths              String?
  improvements           String?
  suggestions            String?
  follow_up_tip          String?
  generated_at           DateTime?           @default(now()) @db.Timestamptz(6)
  ai_model_used          String?             @db.VarChar(100)
  interview_questions    interview_questions @relation(fields: [question_id], references: [id], onDelete: Cascade)
  user_responses         user_responses      @relation(fields: [response_id], references: [id], onDelete: Cascade)
  interview_sessions     interview_sessions  @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([generated_at], map: "idx_feedback_generated_at")
  @@index([overall_response_score], map: "idx_feedback_overall_score")
  @@index([question_id], map: "idx_feedback_question_id")
  @@index([response_id], map: "idx_feedback_response_id")
  @@index([session_id], map: "idx_feedback_session_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model interview_questions {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id              String             @db.Uuid
  question_number         Int
  question_type           String?            @db.VarChar(50)
  question_text           String
  ideal_answer_guidelines String?
  difficulty_level        String?            @db.VarChar(50)
  generated_at            DateTime?          @default(now()) @db.Timestamptz(6)
  ai_model_used           String?            @db.VarChar(100)
  feedback                feedback[]
  interview_sessions      interview_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user_responses          user_responses[]

  @@index([session_id, question_number], map: "idx_interview_questions_question_number")
  @@index([session_id], map: "idx_interview_questions_session_id")
  @@index([question_type], map: "idx_interview_questions_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model interview_sessions {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String                @db.Uuid
  job_description_id  String?               @db.Uuid
  session_title       String?               @db.VarChar(255)
  status              String?               @default("in_progress") @db.VarChar(50)
  total_questions     Int?                  @default(0)
  questions_answered  Int?                  @default(0)
  overall_score       Decimal?              @db.Decimal(5, 2)
  started_at          DateTime?             @default(now()) @db.Timestamptz(6)
  completed_at        DateTime?             @db.Timestamptz(6)
  duration_seconds    Int?
  is_archived         Boolean?              @default(false)
  notes               String?
  feedback            feedback[]
  interview_questions interview_questions[]
  job_descriptions    job_descriptions?     @relation(fields: [job_description_id], references: [id])
  users               users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session_statistics  session_statistics?
  user_responses      user_responses[]

  @@index([completed_at], map: "idx_interview_sessions_completed_at")
  @@index([started_at(sort: Desc)], map: "idx_interview_sessions_started_at")
  @@index([status], map: "idx_interview_sessions_status")
  @@index([user_id], map: "idx_interview_sessions_user_id")
  @@index([user_id, status], map: "idx_interview_sessions_user_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model job_descriptions {
  id                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                   String                   @db.Uuid
  title                     String                   @db.VarChar(255)
  company_name              String?                  @db.VarChar(255)
  job_content               String
  key_skills                String[]
  required_experience_level String?                  @db.VarChar(50)
  industry                  String?                  @db.VarChar(100)
  search_vector             Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('english'::regconfig, (COALESCE(title, ''::character varying))::text), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, (COALESCE(company_name, ''::character varying))::text), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(job_content, ''::text)), 'C'::\"char\"))"))
  created_at                DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                @default(now()) @db.Timestamptz(6)
  is_active                 Boolean?                 @default(true)
  interview_sessions        interview_sessions[]
  users                     users                    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([created_at], map: "idx_job_descriptions_created_at")
  @@index([is_active], map: "idx_job_descriptions_is_active")
  @@index([search_vector], map: "idx_job_descriptions_search", type: Gist)
  @@index([key_skills], map: "idx_job_descriptions_skills", type: Gin)
  @@index([user_id, is_active], map: "idx_job_descriptions_user_active")
  @@index([user_id], map: "idx_job_descriptions_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reminders {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  reminder_type String?   @db.VarChar(50)
  title         String    @db.VarChar(255)
  message       String?
  scheduled_at  DateTime? @db.Timestamptz(6)
  sent_at       DateTime? @db.Timestamptz(6)
  is_read       Boolean?  @default(false)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([is_read], map: "idx_reminders_is_read")
  @@index([scheduled_at], map: "idx_reminders_scheduled_at")
  @@index([sent_at], map: "idx_reminders_sent_at")
  @@index([user_id], map: "idx_reminders_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model session_statistics {
  id                          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id                  String             @unique @db.Uuid
  user_id                     String             @db.Uuid
  avg_relevance_score         Decimal?           @db.Decimal(5, 2)
  avg_clarity_score           Decimal?           @db.Decimal(5, 2)
  avg_confidence_score        Decimal?           @db.Decimal(5, 2)
  avg_completeness_score      Decimal?           @db.Decimal(5, 2)
  avg_response_time_seconds   Decimal?           @db.Decimal(10, 2)
  total_speaking_time_seconds Int?
  questions_answered_count    Int?
  questions_skipped_count     Int?
  top_strengths               String[]
  areas_to_improve            String[]
  calculated_at               DateTime?          @default(now()) @db.Timestamptz(6)
  interview_sessions          interview_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)
  users                       users              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([session_id], map: "idx_session_statistics_session_id")
  @@index([user_id], map: "idx_session_statistics_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_responses {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_id               String              @db.Uuid
  session_id                String              @db.Uuid
  user_id                   String              @db.Uuid
  original_audio_url        String?             @db.VarChar(512)
  transcribed_text          String
  response_duration_seconds Int?
  transcription_confidence  Decimal?            @db.Decimal(3, 2)
  response_created_at       DateTime?           @default(now()) @db.Timestamptz(6)
  feedback                  feedback?
  interview_questions       interview_questions @relation(fields: [question_id], references: [id], onDelete: Cascade)
  interview_sessions        interview_sessions  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  users                     users               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([response_created_at], map: "idx_user_responses_created_at")
  @@index([question_id], map: "idx_user_responses_question_id")
  @@index([session_id], map: "idx_user_responses_session_id")
  @@index([user_id], map: "idx_user_responses_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_statistics {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String    @unique @db.Uuid
  total_sessions           Int?      @default(0)
  completed_sessions       Int?      @default(0)
  total_questions_answered Int?      @default(0)
  average_session_score    Decimal?  @db.Decimal(5, 2)
  last_session_date        DateTime? @db.Timestamptz(6)
  session_streak_days      Int?      @default(0)
  best_session_score       Decimal?  @db.Decimal(5, 2)
  worst_session_score      Decimal?  @db.Decimal(5, 2)
  best_question_type       String?   @db.VarChar(50)
  weakest_question_type    String?   @db.VarChar(50)
  updated_at               DateTime? @default(now()) @db.Timestamptz(6)
  users                    users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([average_session_score(sort: Desc)], map: "idx_user_statistics_average_score")
  @@index([user_id], map: "idx_user_statistics_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String               @unique @db.VarChar(255)
  full_name          String?              @db.VarChar(255)
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)
  last_login         DateTime?            @db.Timestamptz(6)
  is_active          Boolean?             @default(true)
  profile_completed  Boolean?             @default(false)
  audit_log          audit_log[]
  interview_sessions interview_sessions[]
  job_descriptions   job_descriptions[]
  reminders          reminders[]
  session_statistics session_statistics[]
  user_responses     user_responses[]
  user_statistics    user_statistics?

  @@index([created_at], map: "idx_users_created_at")
  @@index([email], map: "idx_users_email")
  @@index([is_active], map: "idx_users_is_active")
}
