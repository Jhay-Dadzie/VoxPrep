# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

PORT=5050

# --- Supabase ---
# Dashboard > Project Settings > Data API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Safe for client use. Dashboard > Project Settings > API Keys > anon/publishable
SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Bypasses Row Level Security — never ship this to the app.
# Dashboard > Project Settings > API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string. Dashboard > Connect > ORMs / Session pooler.
# Use the pooled connection string (port 6543) for serverless-style access.
DATABASE_URL=

# --- AI services ---
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=
ASSEMBLYAI_API_KEY=

# --- Cloud voice ---
# Tried in order: ElevenLabs, Gemini, then the device's own speech. Each tier
# is only used if the one above is unset or fails, so a spent quota changes how
# the interviewer sounds, never whether it speaks.
GEMINI_TTS_ENABLED=true
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
